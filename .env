# URL de la API de la cátedra.
# Emulador Android: http://10.0.2.2:3000
# Teléfono real:    http://IP-DE-TU-PC:3000
# Build preview (APK): usar https y definirla en eas.json > build.preview.env
EXPO_PUBLIC_API_URL=http://192.168.100.69:3000

# true  = la app usa datos falsos de src/mocks/ (no necesita API ni internet)
# false = la app le pide todo a la API real
EXPO_PUBLIC_USAR_MOCK=false
