{
  "expo": {
    "name": "Reservas Deportivas",
    "slug": "reservas-deportivas",
    "scheme": "reservasdeportivas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.reservasdeportivas.villaguay"
    },
    "android": {
      "package": "com.reservasdeportivas.villaguay",
      "adaptiveIcon": {
        "backgroundColor": "#0B3A5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REEMPLAZAR_CON_LA_API_KEY"
        }
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B3A5E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos el rostro para desbloquear tu sesión."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear el código QR de las reservas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegí fotos del estado de las canchas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrar el complejo más cercano y cómo llegar."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "80667fcb-fa1b-4775-baf7-27ebc3975f24"
      }
    },
    "owner": "joaquinpriotti"
  }
}
