{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REEMPLAZAR-POR-LA-URL-DE-LA-API",
        "EXPO_PUBLIC_USAR_MOCK": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
